# --- Storage ---
DB_BACKEND=sqlite                  # sqlite | mongodb
SQLITE_PATH=./data/gov_rag.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gov_rag

# --- Vector store ---
VECTOR_STORE_BACKEND=numpy         # numpy | faiss | qdrant | pgvector
VECTOR_STORE_PATH=./data/vector_store

# --- Embeddings ---
EMBEDDING_PROVIDER=tfidf_svd       # tfidf_svd | sentence_transformers
EMBEDDING_MODEL_NAME=tfidf-svd-256
EMBEDDING_DIMENSIONS=256

# --- Chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Retrieval ---
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.15

# --- HTTP / collection ---
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT=GovInfoRAGBot/1.0 (+standalone-government-knowledge-rag)
MAX_PAGES_PER_SOURCE_PER_RUN=50

# --- LLM (answer generation) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY_ENV_VAR=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# --- Admin auth (RAG admin endpoints only) ---
ADMIN_AUTH_ENABLED=false
ADMIN_API_KEY=

# --- Government Source Discovery ---
DISCOVERY_ENABLED=true
ALLOWED_GOV_SUFFIXES=.gov.in,.nic.in
ALLOWED_GOV_DOMAINS=sidbi.in,cgtmse.in,mudra.org.in,standupmitra.in,udyamregistration.gov.in
DISCOVERY_MAX_URLS_PER_SOURCE=100
DISCOVERY_CRAWL_DELAY_SECONDS=0.5
DISCOVERY_RESPECT_ROBOTS_TXT=true

# --- Automated Periodic Scheduler ---
AUTO_INGESTION_ENABLED=true
AUTO_INGESTION_INTERVAL_HOURS=24
AUTO_INGESTION_MAX_PAGES=50
AUTO_INGESTION_RUN_ON_STARTUP=false
AUTO_INGESTION_STARTUP_GRACE_SECONDS=10

