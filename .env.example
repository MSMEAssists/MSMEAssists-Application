# ==========================================================
# MSMEAssist — Module 1 Backend Environment Variables
# Copy to backend/.env and fill in real values. Never commit .env.
# ==========================================================

# --- App ---
APP_ENV=development                 # development | staging | production
APP_NAME=MSMEAssist Module 1
API_PREFIX=/api

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=msmeassist_dev

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_SCHEME=bcrypt          # bcrypt | argon2

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Document Storage ---
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_PATH=./storage/documents
MAX_UPLOAD_SIZE_MB=10

# --- S3-compatible storage (only used when STORAGE_BACKEND=s3) ---
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=                     # leave blank for AWS S3; set for MinIO/other providers

# --- Module 2 integration ---
MODULE_2_ALLOWED=true                # toggles whether external service tokens are accepted in this env

# --- Logging ---
LOG_LEVEL=INFO
