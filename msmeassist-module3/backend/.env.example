# ==========================================================
# MSMEAssist — Module 3: Explainable AI Recommendation Engine
# ==========================================================

APP_ENV=development
APP_NAME=MSMEAssist Module 3 (Explainable AI Recommendations)
MODULE_PORT=8002

# Upstream Services
MODULE1_BASE_URL=http://localhost:8000
RAG_BASE_URL=http://localhost:8001

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Recommendation & Pairwise Settings
TOP_K_CANDIDATES=5
BTL_MAX_ITERATIONS=100
BTL_TOLERANCE=0.000001
BTL_SMOOTHING=0.01

# LLM Configuration
# Options: offline_analytical | gemini | anthropic | openai
LLM_PROVIDER=offline_analytical
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
